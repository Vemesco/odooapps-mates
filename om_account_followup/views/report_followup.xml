<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- One letter per customer, rendered in the customer's language -->
        <template id="report_followup_document">
            <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang or o.env.lang)"/>
            <t t-call="web.external_layout">
                <div class="page">
                    <p>
                        <span t-field="o.invoice_partner_id"/>
                        <br/>
                        <t t-if="o.partner_id.vat">
                            <span t-field="o.partner_id.vat"/>
                            <br/>
                        </t>
                        Document: Customer account statement
                        <br/>
                        Date:
                        <span t-out="data['date']" t-options="{'widget': 'date'}"/>
                        <br/>
                        Customer ref:
                        <span t-field="o.partner_id.ref"/>
                    </p>

                    <p t-out="get_text(o, data['followup_id'])"/>

                    <t t-foreach="getLines(o)" t-as="cur_lines">
                        <table class="table table-sm" style="margin-top: 50px;">
                            <thead>
                                <tr>
                                    <th>Invoice Date</th>
                                    <th>Description</th>
                                    <th class="text-center">Ref</th>
                                    <th class="text-center">Maturity Date</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="cur_lines['line']" t-as="line">
                                    <td>
                                        <span t-out="line['date']" t-options="{'widget': 'date'}"/>
                                    </td>
                                    <td>
                                        <span t-out="line['name']"/>
                                    </td>
                                    <td>
                                        <span t-out="line['ref']"/>
                                    </td>
                                    <td class="text-center">
                                        <span t-out="line['date_maturity']" t-options="{'widget': 'date'}"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-out="line['balance']"
                                              t-options="{'widget': 'monetary', 'display_currency': line['currency_id']}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <p>Total:
                            <span t-out="cur_lines['total']"
                                  t-options="{'widget': 'monetary', 'display_currency': cur_lines['currency']}"/>
                        </p>
                    </t>
                </div>
            </t>
        </template>

        <template id="report_followup">
            <t t-call="web.html_container">
                <t t-foreach="ids_to_objects(data['partner_ids'])" t-as="o">
                    <t t-call="om_account_followup.report_followup_document"
                       t-lang="o.partner_id.lang"/>
                </t>
            </t>
        </template>

    </data>
</odoo>
